# --- Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=

# One access token per business, named by "access_token_env" in the tenants file.
# Leave a token unset and that tenant falls back to the in-memory channel.
WHATSAPP_TOKEN_PELUQUERIA=
WHATSAPP_TOKEN_KINESIO=

# --- Google Calendar (one service account serves every tenant)
# Each business shares its own calendar with the service account email and
# grants "Make changes to events". Unset means the in-memory calendar.
GOOGLE_CREDENTIALS_FILE=

# --- Businesses served by this deploy. Unset means the demo business only.
TENANTS_FILE=tenants.example.json

# El JSON entero. Producción.
GOOGLE_CREDENTIALS_JSON=
# La ruta al archivo. Desarrollo local.
GOOGLE_CREDENTIALS_FILE=service-account.json
